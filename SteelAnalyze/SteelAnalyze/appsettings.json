{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=steelanalyze.db"
  },
  "Storage": {
    "Root": "storage"
  },
  "Model": {
    "Path": "model.onnx"
  },
  "Jwt": {
    "Issuer": "SteelAnalyzeServer",
    "Audience": "SteelAnalyzeClient",
    "Key": "steelanalyze_dev_signing_key_change_me_in_production_0123456789",
    "LifetimeMinutes": 60
  }
}
